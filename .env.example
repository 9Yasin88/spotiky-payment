# PayPal Live app credentials from PayPal Developer -> Apps & Credentials.
# NEVER commit your real secret to GitHub.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_LIVE_CLIENT_SECRET
PAYPAL_ENVIRONMENT=live

# Your deployed Render URL, for example:
# https://spotiky-payment.onrender.com
BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Must be your Snapchat contact URL.
SNAPCHAT_URL=https://www.snapchat.com/t/XJtZak2u
